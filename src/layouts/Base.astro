---
import { STORE } from "../links";
// The frame every page shares: <head>, the top menu and the footer. Change the menu or footer here only.
// Links start with / so they work from any page, including /topics/…
interface Props {
  title: string;
  description?: string;
  path?: string; // the page's address, e.g. "/privacy"; leave out for pages Google shouldn't list
  current?: "home" | "blog" | "help" | "privacy" | "terms";
  mainClass?: string;
}
const { title, description, path, current, mainClass } = Astro.props;
const home = current === "home" ? "" : "/"; // on the home page the menu just scrolls
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{path && <link rel="canonical" href={new URL(path, Astro.site).href}>}
<slot name="head-meta" />
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<slot name="head-early" />
<link rel="stylesheet" href="/style.css">
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="wrap">
  <a class="brand" href="/">
    <img src="/icon.svg" alt="">
    ShakeFree Mouse
  </a>
  <nav aria-label="Main">
    <!-- On small screens the links fold away behind this button (only once the script below runs) -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <span>Menu</span>
    </button>
    <div class="nav-links" id="nav-links">
      <a href={`${home}#how`}>How it helps</a>
      {current === "home" && <a href="#demo">Demo</a>}
      <a href={`${home}#pricing`}>Pricing</a>
      <a href="/blog" aria-current={current === "blog" ? "page" : undefined}>Blog</a>
      <a href="/support" aria-current={current === "help" ? "page" : undefined}>Help</a>
      <a class="button menu-try" href={STORE}>Try it free</a>
    </div>
    <a class="button header-try" href={STORE}>Try it free</a>
  </nav>
</div></header>
<script is:inline>
// Small screens: open and close the menu; it closes again after picking a link or pressing Esc
(function () {
  var toggle = document.querySelector(".menu-toggle"), label = toggle.querySelector("span");
  document.documentElement.classList.add("js-menu");
  function set(open) {
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    label.textContent = open ? "Close" : "Menu";
  }
  toggle.addEventListener("click", function () { set(toggle.getAttribute("aria-expanded") !== "true"); });
  document.getElementById("nav-links").addEventListener("click", function (e) { if (e.target.closest("a")) set(false); });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { set(false); toggle.focus(); }
  });
})();
</script>

<main id="main" class={mainClass}>
<slot />
</main>

<footer><div class="wrap">
  <div>
    <p class="name">ShakeFree Mouse</p>
    <p>An assistive app for steadier pointing. It is not a medical treatment.</p>
    <p>© 2026 Wahlstrom Digital</p>
  </div>
  <nav class="links" aria-label="Footer">
    <a href="/blog">Blog</a>
    <a href="/support">Help &amp; contact</a>
    <a href="/privacy" aria-current={current === "privacy" ? "page" : undefined}>Privacy policy</a>
    <a href="/terms" aria-current={current === "terms" ? "page" : undefined}>Terms &amp; refunds</a>
  </nav>
</div></footer>
<slot name="end" />
</body>
</html>
