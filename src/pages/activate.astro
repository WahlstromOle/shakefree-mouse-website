---
import Base from "../layouts/Base.astro";
import { STORE, BUY } from "../links";
---
<Base title="Activate ShakeFree Mouse" mainClass="wrap narrow prose">
<Fragment slot="head-meta">
<!-- The licence key is in this page's address: never let it leave the browser (no analytics, no outside files, no referrer). -->
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
</Fragment>
  <div id="has-key" hidden>
    <h1>Thank you! Let’s activate ShakeFree Mouse</h1>
    <p class="lead">If ShakeFree Mouse is installed, it opens and activates by itself. If your browser asks “Open ShakeFree Mouse?”, click <strong>Open</strong>.</p>

    <div class="card">
      <h2>Your key</h2>
      <p class="key" id="key"></p>
      <div class="buttons">
        <button class="button secondary" id="copy" type="button">Copy key</button>
      </div>
      <p class="status" id="status" role="status" aria-live="polite"></p>
    </div>

    <div class="card">
      <h2>Already have ShakeFree Mouse?</h2>
      <div class="buttons">
        <a class="button" id="open" href="#">Open ShakeFree Mouse</a>
      </div>
      <p>If nothing happens:</p>
      <ol class="steps">
        <li>Click <strong>Copy key</strong> above.</li>
        <li>Open ShakeFree Mouse from the tray: the round blue icon by the clock (click the <strong>^</strong> arrow if you can’t see it).</li>
        <li>Click <strong>Enter key</strong>. The key fills in by itself.</li>
        <li>Click <strong>Activate</strong>.</li>
      </ol>
    </div>

    <div class="card">
      <h2>Don’t have it yet?</h2>
      <p>ShakeFree Mouse is downloaded free from Microsoft Store.</p>
      <div class="buttons">
        <a class="button" href={STORE}>Download from Microsoft Store</a>
      </div>
      <ol class="steps">
        <li>Install ShakeFree Mouse from Microsoft Store.</li>
        <li>Come back to this page and click <strong>Open ShakeFree Mouse</strong>, or click <strong>Activate</strong> in your receipt email again. The app opens and activates by itself.</li>
        <li>Or open the app, click <strong>Enter key</strong> and paste your key.</li>
      </ol>
    </div>

    <p class="muted">Your key is also in your receipt email, so you can activate any time later. It works on up to 3 PCs.</p>
  </div>

  <div id="no-key" hidden>
    <h1>No key found</h1>
    <p class="lead">This page didn’t receive a licence key.</p>
    <p>Please open your receipt email from Lemon Squeezy and click <strong>Activate</strong> there, or copy the key from the email into ShakeFree Mouse: open it from the tray, click <strong>Enter key</strong>, then <strong>Activate</strong>.</p>
    <p>Don’t have the app yet? <a href={STORE}>Download it free from Microsoft Store</a> first.</p>
    <p>Can’t find the email? <a href="support.html">Contact us</a> and we’ll help.</p>
  </div>
<Fragment slot="end">
<script is:inline>
(function () {
  var key = (new URLSearchParams(location.search).get("key") || "").trim();
  if (!key) { document.getElementById("no-key").hidden = false; return; }

  var appLink = "shakefree://activate?key=" + encodeURIComponent(key);
  document.getElementById("has-key").hidden = false;
  document.getElementById("key").textContent = key;

  var open = document.getElementById("open");
  open.href = appLink;

  var status = document.getElementById("status");
  document.getElementById("copy").addEventListener("click", function () {
    function done() { status.textContent = "✓ Copied. Now open ShakeFree Mouse and click Enter key."; }
    function fallback() {
      var box = document.createElement("textarea");
      box.value = key;
      document.body.appendChild(box);
      box.select();
      var ok = false;
      try { ok = document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(box);
      status.textContent = ok ? "" : "Couldn’t copy. Please select the key above and copy it.";
      if (ok) done();
    }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(key).then(done, fallback);
    else fallback();
  });

  // Try to open the app straight away.
  location.href = appLink;
})();
</script>
</Fragment>
</Base>
